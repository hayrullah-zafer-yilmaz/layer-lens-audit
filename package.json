{
  "name": "layer-lens-audit",
  "version": "0.1.0",
  "description": "Find the divs your interface doesn't need: a DOM audit for any web page, in the browser, on the command line and in CI, with an exploded 3D view of what it finds.",
  "license": "MIT",
  "author": "Hayrullah Zafer Yılmaz",
  "homepage": "https://hayrullah-zafer-yilmaz.github.io/layer-lens-audit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayrullah-zafer-yilmaz/layer-lens-audit.git"
  },
  "bugs": {
    "url": "https://github.com/hayrullah-zafer-yilmaz/layer-lens-audit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/layer-lens-audit.global.js",
  "jsdelivr": "./dist/layer-lens-audit.global.js",
  "bin": {
    "layer-lens-audit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite demo",
    "build": "tsup",
    "build:demo": "vite build demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package && npm run test:browser"
  },
  "keywords": [
    "3d",
    "angular",
    "audit",
    "bookmarklet",
    "ci",
    "cli",
    "devtools",
    "div",
    "dom",
    "dom-size",
    "inspector",
    "lighthouse",
    "lint",
    "performance",
    "playwright",
    "react",
    "svelte",
    "vite",
    "vite-plugin",
    "vue",
    "wrapper"
  ],
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.1",
    "tsup": "^9.0.0",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
